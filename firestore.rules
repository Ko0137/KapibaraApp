rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    // Leaderboard
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update, delete: if isValidId(userId);
    }

    // Active Live Players Lobby for PvP & Matchmaking
    match /activePlayers/{userId} {
      allow read: if true;
      allow create, update, delete: if isValidId(userId);
    }

    // Live PvP Duel Rooms
    match /duelRooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if isValidId(roomId);
    }

    // Direct PvP Duel Challenges
    match /duelChallenges/{challengeId} {
      allow read: if true;
      allow create, update, delete: if isValidId(challengeId);
    }

    // User Auto-Saves
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Cloud Saves by Code
    match /cloudSaves/{cloudId} {
      allow read, write: if isValidId(cloudId);
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
